# Shopify App Credentials (from Partner Dashboard)
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here

# E-Mail-Versand via Resend (HTTPS).
# Kein SMTP: der Produktionshost blockiert ausgehenden Port 465.
# Voraussetzung: Absenderdomain in Resend verifiziert (DKIM/SPF im DNS).
RESEND_API_KEY=re_your_key_here
MAIL_FROM=Tessanda Handweberei <shop@tessanda.ch>

# Admin notification email
ADMIN_EMAIL=allegra@tessanda.ch
# Optional: zweite interne Empfaengeradresse
# ADMIN_EMAIL_2=

# App URL (for local dev, shopify CLI sets this automatically via ngrok)
APP_URL=https://your-ngrok-or-fly-url.dev
