{
  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"],
  "exclude": ["node_modules", "build", "extensions/*/assets", ".cache"],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "isolatedModules": true,
    // Type-checking only. Without this, `npm run typecheck` (plain `tsc`) emits
    // .js files next to every .ts/.tsx source; imports like "./App.js" then
    // resolve to those stale artifacts instead of the real sources, so builds
    // silently ship outdated code. Vite/Remix do all the actual compiling.
    "noEmit": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
